PORT=8003
DB_URL=mongodb://localhost:27017/shopping

# URL publica del catalogo. shopping consulta precios y disponibilidad por
# HTTP contra esta API; nunca contra la base de products.
PRODUCTS_URL=http://host.docker.internal:8002

# El MISMO valor que customers/.env. shopping solo verifica firmas, nunca
# emite tokens. Copia este archivo a .env y pon el valor alli.
APP_SECRET=
