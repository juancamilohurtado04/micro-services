# Puerta de entrada unica del sistema. Es el unico puerto que el navegador
# debe conocer: el frontend apunta aqui y a ningun microservicio directo.
PORT=8000

# URLs internas de los microservicios. Con docker-compose por servicio, cada
# contenedor publica su puerto en el host, y el gateway los alcanza por
# host.docker.internal. Fuera de Docker, cambia el host por localhost.
CUSTOMERS_URL=http://host.docker.internal:8001
PRODUCTS_URL=http://host.docker.internal:8002
SHOPPING_URL=http://host.docker.internal:8003
